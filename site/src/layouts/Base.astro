---
import '@fontsource-variable/inter';
import '@fontsource/playfair-display/400.css';
import '@fontsource/playfair-display/500.css';
import '@fontsource/playfair-display/400-italic.css';

import '../styles/tokens.css';
import '../styles/typography.css';
import '../styles/global.css';

interface Props {
  titel: string;
  beschreibung: string;
}

const { titel, beschreibung } = Astro.props;

const kanonischeUrl = new URL(Astro.url.pathname, Astro.site);
const ogBildUrl = new URL(`${import.meta.env.BASE_URL}bilder/hero-sakko.webp`, Astro.site);

const strukturierteDaten = {
  '@context': 'https://schema.org',
  '@type': ['LocalBusiness', 'ClothingStore'],
  name: 'Änderungsschneiderei und Second-Hand Marli',
  alternateName: 'Marli Änderungsschneiderei',
  description: beschreibung,
  image: ogBildUrl.href,
  url: kanonischeUrl.href,
  telephone: '+49 170 3540309',
  address: {
    '@type': 'PostalAddress',
    streetAddress: 'Rosenheimer Str. 29a',
    postalCode: '83059',
    addressLocality: 'Kolbermoor',
    addressCountry: 'DE',
  },
  geo: {
    '@type': 'GeoCoordinates',
    latitude: 47.84981017379262,
    longitude: 12.068574560278552,
  },
  areaServed: [
    { '@type': 'City', name: 'Kolbermoor' },
    { '@type': 'City', name: 'Rosenheim' },
  ],
  sameAs: [
    'https://www.google.com/maps/place/?q=place_id:0x47761b0a472264a3:0x6a5f49446c5c4e81',
  ],
  aggregateRating: {
    '@type': 'AggregateRating',
    ratingValue: '5.0',
    reviewCount: '2',
  },
  openingHoursSpecification: [
    {
      '@type': 'OpeningHoursSpecification',
      dayOfWeek: ['Monday', 'Tuesday', 'Wednesday', 'Thursday', 'Friday'],
      opens: '10:00',
      closes: '18:00',
    },
    {
      '@type': 'OpeningHoursSpecification',
      dayOfWeek: ['Saturday'],
      opens: '09:00',
      closes: '13:00',
    },
  ],
};
---

<!doctype html>
<html lang="de" data-theme="hell">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{titel}</title>
    <meta name="description" content={beschreibung} />
    <link rel="canonical" href={kanonischeUrl.href} />
    <link rel="icon" type="image/svg+xml" href={`${import.meta.env.BASE_URL}favicon.svg`} />
    <meta name="theme-color" content="#faf6f0" />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Marli" />
    <meta property="og:locale" content="de_DE" />
    <meta property="og:title" content={titel} />
    <meta property="og:description" content={beschreibung} />
    <meta property="og:url" content={kanonischeUrl.href} />
    <meta property="og:image" content={ogBildUrl.href} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={titel} />
    <meta name="twitter:description" content={beschreibung} />
    <meta name="twitter:image" content={ogBildUrl.href} />

    <script type="application/ld+json" is:inline set:html={JSON.stringify(strukturierteDaten)} />

    <!-- Modus vor dem ersten Paint setzen, damit es nicht kurz aufblitzt -->
    <script is:inline>
      (function () {
        try {
          var gespeichert = localStorage.getItem('marli-theme');
          if (gespeichert === 'hell' || gespeichert === 'dunkel') {
            document.documentElement.dataset.theme = gespeichert;
          } else if (window.matchMedia('(prefers-color-scheme: dark)').matches) {
            document.documentElement.dataset.theme = 'dunkel';
          }
        } catch (e) {}
        document.documentElement.classList.add('js-anim');
      })();
    </script>
  </head>
  <body>
    <slot />

    <script>
      const beobachter = new IntersectionObserver(
        (eintraege) => {
          for (const eintrag of eintraege) {
            if (eintrag.isIntersecting) {
              eintrag.target.classList.add('ist-sichtbar');
              beobachter.unobserve(eintrag.target);
            }
          }
        },
        { rootMargin: '0px 0px -10% 0px', threshold: 0.1 },
      );

      document.querySelectorAll('.sektion').forEach((el) => beobachter.observe(el));
    </script>
  </body>
</html>
