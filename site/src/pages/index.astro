---
import Base from '../layouts/Base.astro';
import Nav from '../components/Nav.astro';
import Hero from '../components/Hero.astro';
import WhatWeDo from '../components/WhatWeDo.astro';
import SecondHand from '../components/SecondHand.astro';
import About from '../components/About.astro';
import Testimonials from '../components/Testimonials.astro';
import FindUs from '../components/FindUs.astro';
import Footer from '../components/Footer.astro';
---

<Base
  titel="Marli — Änderungsschneiderei & Second-Hand, Kolbermoor bei Rosenheim"
  beschreibung="Marli Schneiderei: Änderungsschneiderei in Kolbermoor bei Rosenheim mit Kleidung ändern lassen, Hosen kürzen, Reißverschluss reparieren und Brautkleid anpassen – plus kuratierte Second-Hand-Mode zum Stöbern."
>
  <Nav />
  <main>
    <Hero />
    <WhatWeDo />
    <SecondHand />
    <About />
    <Testimonials />
    <FindUs />
  </main>
  <Footer />
</Base>
