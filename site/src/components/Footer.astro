---
/**
 * Footer — Wortmarke, Rechtliches, Copyright.
 * Entspricht Wireframe-Frame 4:57/49:10 (kein hi-fi-Frame gefunden).
 * bg/inverse + ink/inverse bewusst wie im Hero, siehe tokens.css.
 */
---

<footer class="fusszeile">
  <div class="wrap fusszeile__inner">
    <div class="fusszeile__marke">
      <p class="fusszeile__wortmarke">MARLI</p>
      <p class="t-body-small">Änderungsschneiderei &amp; Second-Hand</p>
    </div>

    <nav class="fusszeile__links" aria-label="Rechtliches">
      <a href={`${import.meta.env.BASE_URL}impressum`} class="t-body-small">Impressum</a>
      <a href={`${import.meta.env.BASE_URL}datenschutz`} class="t-body-small">Datenschutz</a>
    </nav>

    <p class="t-caption fusszeile__copyright">© 2026 Marli · Alle Rechte vorbehalten</p>
  </div>
</footer>

<style>
  .fusszeile {
    background-color: var(--color-bg-inverse);
    color: var(--color-ink-inverse);
    padding-block: var(--space-48);
  }

  .fusszeile__inner {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-24);
  }

  .fusszeile__marke {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
  }

  .fusszeile__wortmarke {
    font-family: var(--font-display);
    font-weight: 500;
    font-size: 20px;
    letter-spacing: 3px;
  }

  .fusszeile__marke .t-body-small {
    color: var(--color-ink-inverse-muted);
  }

  .fusszeile__links {
    display: flex;
    gap: var(--space-32);
  }

  .fusszeile__links a {
    color: var(--color-ink-inverse-muted);
    transition: color var(--duration-fast) var(--ease-standard);
  }

  .fusszeile__links a:hover,
  .fusszeile__links a:focus-visible {
    color: var(--color-ink-inverse);
  }

  .fusszeile__copyright {
    color: var(--color-ink-inverse-muted);
  }

  @media (max-width: 899px) {
    .fusszeile__inner {
      flex-direction: column;
      align-items: flex-start;
    }
  }
</style>
