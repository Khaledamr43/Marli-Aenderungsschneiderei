---
/**
 * Änderungen & Maßarbeit — Leistungen + Arbeiten-Galerie.
 * Entspricht Figma-Frame 20:2 (Desktop). In der hi-fi Datei sind
 * "What we do" und "Work gallery" eine einzige Sektion.
 */
import { Image } from 'astro:assets';
import { arbeiten, leistungen } from '../data/arbeiten';
---

<section id="aenderungen" class="sektion">
  <div class="wrap">
    <div class="sektion-kopf">
      <p class="t-eyebrow">Leistungen</p>
      <h2 class="t-h2">Änderungen &amp; Maßarbeit</h2>
      <p class="t-body-large">
        Ob Kleid kürzen, Anzug ändern lassen oder Jacke enger machen – in der Werkstatt in
        Kolbermoor wird jedes Stück von Hand geprüft, gesteckt und genäht. Auch wenn Sie
        Kleidung reparieren lassen möchten, sind Sie hier richtig.
      </p>
    </div>

    <ul class="chips">
      {leistungen.map((leistung) => (
        <li class="chip t-body-small">{leistung}</li>
      ))}
    </ul>

    <ul class="arbeiten-grid">
      {arbeiten.map((arbeit) => (
        <li>
          <figure>
            <div class:list={['arbeit-foto', { 'arbeit-foto--contain': arbeit.fotoFit === 'contain' }]}>
              <Image
                src={arbeit.foto}
                alt=""
                widths={[300, 460]}
                sizes="(max-width: 899px) 100vw, 25vw"
                quality={80}
                loading="lazy"
              />
            </div>
            <figcaption class="t-label-strong">{arbeit.titel}</figcaption>
          </figure>
        </li>
      ))}
    </ul>
  </div>
</section>

<style>
  .chips {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-8);
    list-style: none;
    padding: 0;
    margin-bottom: var(--space-48);
  }

  .chip {
    padding: var(--space-8) var(--space-16);
    border: 1px solid var(--color-border-hairline);
    border-radius: var(--radius-pill);
    background-color: var(--color-bg-surface);
    color: var(--color-ink-primary);
  }

  .arbeiten-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: var(--gutter-desktop);
    list-style: none;
    padding: 0;
  }

  .arbeiten-grid li {
    display: flex;
    flex-direction: column;
  }

  .arbeit-foto {
    position: relative;
    aspect-ratio: 4 / 5;
    border-radius: var(--radius-md);
    overflow: hidden;
    margin-bottom: var(--space-16);
  }

  .arbeit-foto img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform var(--duration-base) var(--ease-standard);
  }

  .arbeit-foto:hover img {
    transform: scale(1.05);
  }

  .arbeit-foto--contain {
    background-color: var(--color-bg-surface);
  }

  .arbeit-foto--contain img {
    object-fit: contain;
  }

  @media (max-width: 899px) {
    .arbeiten-grid {
      grid-template-columns: 1fr;
      gap: var(--space-32);
    }
  }
</style>
