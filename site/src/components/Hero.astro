---
/**
 * Hero — Aufmacher mit Wortmarke, Tagline und Sakko-Foto.
 * Entspricht Figma-Frames 19:2 (Desktop) / 28:12 (Mobil) — dort als
 * "Foto — Hero"-Platzhalter (Foto/Wolle Camel) mit Scrim-Overlay angelegt.
 * Foto + Scrim sind bewusst modus-unabhängig (wie die Foto/*-Verläufe in
 * tokens.css) — Hero bleibt in Hell und Dunkel gleich dunkel.
 */
const heroDesktop = `url(${import.meta.env.BASE_URL}bilder/hero-sakko.webp)`;
const heroMobil = `url(${import.meta.env.BASE_URL}bilder/hero-sakko-mobil.webp)`;
---

<section class="hero" id="hero">
  <div class="wrap hero__wrap">
    <div class="hero__content">
      <span class="hero__regel" aria-hidden="true"></span>
      <p class="t-eyebrow">Kolbermoor bei Rosenheim</p>
      <h1 class="t-display-hero">Marli</h1>
      <p class="t-h2 hero__unterzeile">Änderungsschneiderei<br />&amp; Second-Hand</p>
      <p class="t-body-large hero__text">
        Änderungen mit Handarbeit und kuratierte Second-Hand-Mode in Ihrer Nachbarschaft.
      </p>
    </div>

    <a href="#ueber-uns" class="t-eyebrow hero__scroll">
      <span aria-hidden="true">▾</span> Mehr entdecken
    </a>
  </div>
</section>

<style define:vars={{ heroDesktop, heroMobil }}>
  .hero {
    --hero-scrim: linear-gradient(90deg, rgba(13, 10, 8, 0.55) 0%, rgba(13, 10, 8, 0.05) 65%);

    position: relative;
    display: flex;
    align-items: center;
    min-height: clamp(680px, 47vw, 1000px);
    padding-block: var(--space-96);
    overflow: hidden;
    color: var(--color-ink-inverse);
    background-color: #221a14;
    background-image: var(--hero-scrim), var(--heroDesktop);
    background-size: cover, cover;
    background-position: center, top center;
    background-repeat: no-repeat, no-repeat;
  }

  .hero__wrap {
    position: relative;
    z-index: 1;
    display: flex;
    flex-direction: column;
    gap: var(--space-64);
  }

  .hero__content {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: var(--space-24);
    max-width: 560px;
  }

  .hero__regel {
    width: 56px;
    height: 2px;
    background-color: currentColor;
  }

  .hero__unterzeile {
    margin: 0;
  }

  .hero__text {
    margin: 0;
    max-width: 500px;
    color: var(--color-ink-inverse-muted);
  }

  .hero__scroll {
    display: inline-flex;
    align-items: center;
    gap: var(--space-8);
    color: var(--color-ink-inverse-muted);
  }

  @media (max-width: 899px) {
    .hero {
      background-image: var(--hero-scrim), var(--heroMobil);
      background-position: center, center;

      min-height: clamp(560px, 47vw, 680px);
      padding-block: var(--space-64);
    }

    .hero__wrap {
      gap: var(--space-48);
    }

    .hero__text {
      max-width: 330px;
    }
  }
</style>
