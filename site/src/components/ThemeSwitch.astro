---
/**
 * Theme-Switch — entspricht dem Figma-Component-Set "Theme-Switch"
 * (Varianten Modus=Hell / Modus=Dunkel), 56 × 30 px Pille.
 * Schaltet data-theme auf <html> um und merkt sich die Wahl.
 */
---

<button
  class="theme-switch"
  type="button"
  role="switch"
  aria-checked="false"
  aria-label="Dunkelmodus umschalten"
  data-theme-switch
>
  <span class="theme-switch__icon theme-switch__icon--sonne" aria-hidden="true">
    <svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round">
      <circle cx="8" cy="8" r="3.1" />
      <path d="M8 1v1.6M8 13.4V15M15 8h-1.6M2.6 8H1M12.9 3.1l-1.1 1.1M4.2 11.8l-1.1 1.1M12.9 12.9l-1.1-1.1M4.2 4.2L3.1 3.1" />
    </svg>
  </span>
  <span class="theme-switch__icon theme-switch__icon--mond" aria-hidden="true">
    <svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linejoin="round">
      <path d="M13.2 9.8A5.6 5.6 0 0 1 6.2 2.8a5.6 5.6 0 1 0 7 7Z" />
    </svg>
  </span>
  <span class="theme-switch__knopf" aria-hidden="true"></span>
</button>

<style>
  .theme-switch {
    position: relative;
    display: inline-flex;
    align-items: center;
    justify-content: space-between;
    width: 56px;
    height: 30px;
    padding: 0 7px;
    border: 1px solid var(--color-border-hairline);
    border-radius: var(--radius-pill);
    background-color: var(--color-bg-muted);
    transition: background-color var(--duration-base) var(--ease-standard),
      border-color var(--duration-base) var(--ease-standard);
  }

  .theme-switch:hover {
    border-color: var(--color-accent-brass);
  }

  .theme-switch__icon {
    display: grid;
    place-items: center;
    width: 14px;
    height: 14px;
    color: var(--color-ink-secondary);
    z-index: 1;
    transition: color var(--duration-fast) var(--ease-standard);
  }

  .theme-switch__knopf {
    position: absolute;
    top: 3px;
    left: 3px;
    width: 22px;
    height: 22px;
    border-radius: var(--radius-pill);
    background-color: var(--color-bg-surface);
    box-shadow: 0 1px 2px rgb(0 0 0 / 18%);
    transition: transform var(--duration-base) var(--ease-standard),
      background-color var(--duration-base) var(--ease-standard);
  }

  .theme-switch[aria-checked='true'] .theme-switch__knopf {
    transform: translateX(26px);
  }

  .theme-switch[aria-checked='false'] .theme-switch__icon--sonne,
  .theme-switch[aria-checked='true'] .theme-switch__icon--mond {
    color: var(--color-accent-brass);
  }
</style>

<script>
  const STORAGE_KEY = 'marli-theme';

  function anwenden(modus: string) {
    document.documentElement.dataset.theme = modus;
    document.querySelectorAll<HTMLButtonElement>('[data-theme-switch]').forEach((el) => {
      el.setAttribute('aria-checked', String(modus === 'dunkel'));
    });
  }

  document.querySelectorAll<HTMLButtonElement>('[data-theme-switch]').forEach((el) => {
    el.addEventListener('click', () => {
      const neu = document.documentElement.dataset.theme === 'dunkel' ? 'hell' : 'dunkel';
      anwenden(neu);
      try {
        localStorage.setItem(STORAGE_KEY, neu);
      } catch {
        /* Speichern nicht möglich — Wahl gilt nur für diese Sitzung */
      }
    });
  });

  anwenden(document.documentElement.dataset.theme ?? 'hell');
</script>
